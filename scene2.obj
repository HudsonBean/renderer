# checker_test.obj — depth-buffer + perspective-correct-interpolation test scene
# Camera at origin, looking down -z. Uses v/vt/vn faces: the vt (texture
# coords) drive a PROCEDURAL checkerboard you compute per-pixel as
#   checker(u,v) = (floor(u) + floor(v)) & 1
# (UVs below are pre-scaled to the tile count, so no extra *N is needed.)
#
# TWO tests, deliberately separated:
#
#   FLOOR  -> perspective-correct interpolation test.
#            It recedes steeply (z = -3 near ... -22 far), so its checker
#            squares must COMPRESS toward the far edge. Interpolate u,v
#            LINEARLY and the squares visibly bend/warp along the diagonal
#            seam. Interpolate PERSPECTIVE-CORRECTLY (attr/w, 1/w, divide)
#            and they stay square and foreshorten smoothly. This is the
#            surface where the two methods DIFFER.
#
#   WALLS  -> depth-buffer test (and a control for the floor).
#            Two flat quads facing the camera at different depths (z=-6 and
#            z=-11) that OVERLAP in screen space. The near wall must cleanly
#            occlude the far one. Because each wall is a single constant-z
#            plane, all its vertices share the same w -- so linear and
#            perspective-correct interpolation give IDENTICAL results on the
#            walls. That makes them a control: if your perspective-correct
#            code is wrong, the FLOOR breaks but the WALLS stay fine.

# ---------------- normals ----------------
vn  0.0  1.0  0.0     # 1  up      (floor faces up)
vn  0.0  0.0  1.0     # 2  +z      (walls face the camera)

# ---------------- texture coords (pre-scaled to tile counts) ----------------
vt 0.0 0.0            # 1
vt 4.0 0.0            # 2   floor near-right (4 tiles wide)
vt 4.0 8.0            # 3   floor far-right  (8 tiles deep)
vt 0.0 8.0            # 4   floor far-left
vt 3.0 0.0            # 5   wall  (3 tiles wide)
vt 3.0 3.0            # 6   wall  (3x3)
vt 0.0 3.0            # 7   wall

# ================= FLOOR (recedes into the distance) =================
g floor
v -6.0 -2.0  -3.0     # 1  near-left
v  6.0 -2.0  -3.0     # 2  near-right
v  6.0 -2.0 -22.0     # 3  far-right
v -6.0 -2.0 -22.0     # 4  far-left
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# ================= WALL A (near, z = -6) =================
g wall_near
v -3.0 -2.0  -6.0     # 5  bottom-left
v  0.5 -2.0  -6.0     # 6  bottom-right
v  0.5  1.5  -6.0     # 7  top-right
v -3.0  1.5  -6.0     # 8  top-left
f 5/1/2 6/5/2 7/6/2
f 5/1/2 7/6/2 8/7/2

# ================= WALL B (far, z = -11, overlaps A on screen) =================
g wall_far
v -1.0 -2.0 -11.0     # 9  bottom-left
v  2.5 -2.0 -11.0     # 10 bottom-right
v  2.5  1.5 -11.0     # 11 top-right
v -1.0  1.5 -11.0     # 12 top-left
f 9/1/2 10/5/2 11/6/2
f 9/1/2 11/6/2 12/7/2
